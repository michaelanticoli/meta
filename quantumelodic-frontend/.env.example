# Quantumelodic Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:5000

# Supabase Configuration (for future auth integration)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Feature Flags
VITE_ENABLE_AUTH=false
VITE_ENABLE_SAVE_CHARTS=false
