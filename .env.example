# Environment Variables for Magic Portfolio
# Copy this file to .env.local for local development

# ============================================
# REQUIRED FOR PRODUCTION
# ============================================

# Environment mode
NODE_ENV=development

# ============================================
# OPTIONAL FEATURES
# ============================================

# Password for protected pages/routes (leave empty to disable)
PAGE_ACCESS_PASSWORD=

# Site URL (used for generating absolute URLs, OG images, etc.)
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ============================================
# DEPLOYMENT PLATFORM SPECIFIC
# ============================================

# Vercel (automatically set by Vercel)
# VERCEL_URL=

# Build configuration for Docker
# BUILD_STANDALONE=true

# ============================================
# ANALYTICS & MONITORING (Future)
# ============================================

# Vercel Analytics (automatically enabled on Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Sentry Error Tracking
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ============================================
# CI/CD (GitHub Actions Secrets)
# ============================================

# Vercel deployment tokens (set in GitHub Secrets, not here)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
